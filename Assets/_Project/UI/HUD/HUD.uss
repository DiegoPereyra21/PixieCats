
.time-panel {
    position: absolute;
    top: 24px;
    right: 24px;
    padding: 10px 18px;
    background-color: rgba(15, 20, 40, 0.75);
    border-radius: 8px;
}

.time-label {
    color: rgb(240, 235, 220);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
