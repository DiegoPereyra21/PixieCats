<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/HUD/NarrativeDialogueHUD.uss?fileID=7433441132597879392&amp;guid=efd93614b535ee246a2a806afba1544a&amp;type=3#NarrativeDialogueHUD"/>
    <ui:VisualElement name="NarrativeDialogueRoot" class="narrative-dialogue-root" style="flex-grow: 1; display: none;">
        <ui:VisualElement name="DialoguePanel" class="dialogue-panel" style="flex-grow: 1; max-height: 350px; background-image: url(&quot;project://database/Assets/_Project/Art/UI/Leaf&amp;Branch%20UI%20Pack/ProfileBar1_Leaf&amp;Branch.png?fileID=2800000&amp;guid=6ac5205b458a19142a06a5d19d25c7c7&amp;type=3#ProfileBar1_Leaf&amp;Branch&quot;); background-size: auto auto; background-position-x: center; -unity-background-scale-mode: stretch-to-fill; background-repeat: no-repeat no-repeat; -unity-slice-type: tiled; flex-shrink: 0; max-width: 1500px; bottom: -116px; flex-direction: row; justify-content: center; align-self: center; padding-left: 220px; padding-bottom: 29px; -unity-background-image-tint-color: rgb(51, 36, 63);">
<ui:VisualElement name="PortraitContainer" class="portrait-container" style="left: 14%; width: 17%;">
    <ui:Image name="CharacterPortrait" class="character-portrait" scale-mode="ScaleToFit"/>
</ui:VisualElement>
        <ui:Label text="Label" name="CharacterName" class="character-name" style="left: 13%; bottom: 85%; -unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/OldeTome.ttf?fileID=12800000&amp;guid=cf680035c157c3b47b836e2ad49c61f2&amp;type=3#OldeTome&quot;); font-size: 54px; -unity-font-style: bold;"/>
            <ui:VisualElement name="DialogueContent" class="dialogue-content" style="flex-grow: 1; flex-direction: row;">
                <ui:VisualElement name="DialogueBackground" class="dialogue-background" style="flex-grow: 1; max-height: 180px; max-width: 700px; width: 630px; margin-top: 30px; border-bottom-left-radius: 15px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; background-color: rgba(232, 213, 169, 0.72); margin-left: 155px;">
                    <ui:Label text="Texto del dialogo" name="DialogueText" class="dialogue-text" style="font-size: 30px; -unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/Handlee-Regular.ttf?fileID=12800000&amp;guid=1a3e39fffd120a046915f726453b464d&amp;type=3#Handlee-Regular&quot;); letter-spacing: 1.5px; word-spacing: 1px; -unity-font-style: bold; margin-left: 10px;"/>
                </ui:VisualElement>
                <ui:Button text="[E] Continuar" name="NextButton" class="next-button" style="bottom: 68px; right: 137px; -unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/Handlee-Regular.ttf?fileID=12800000&amp;guid=1a3e39fffd120a046915f726453b464d&amp;type=3#Handlee-Regular&quot;); font-size: 18px; height: auto;"/>
                <ui:Button text="No" name="DeclineButton" class="next-button decline-button" style="bottom: 68px; right: 25px; -unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/Handlee-Regular.ttf?fileID=12800000&amp;guid=1a3e39fffd120a046915f726453b464d&amp;type=3#Handlee-Regular&quot;); font-size: 18px; height: auto; display: none;"/>
                </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>