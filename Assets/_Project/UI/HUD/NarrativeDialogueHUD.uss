
.narrative-dialogue-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    justify-content: flex-end;
    align-items: center;

    padding-left: 5%;
    padding-right: 5%;
    padding-bottom: 4%;
}

.dialogue-panel {
    position: relative;

    width: 100%;
    max-width: 1250px;
    height: 180px;
    min-height: 180px;
    max-height: 180px;
    flex-shrink: 0;

    flex-direction: row;
    align-items: center;

    padding: 0;

    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;

    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

.portrait-container {
    position: absolute;

    left: 3.5%;
    top: 15%;

    width: 13%;
    height: 70%;

    flex-shrink: 0;
    flex-grow: 0;

    justify-content: center;
    align-items: center;
}

.character-portrait {
    width: 100%;
    height: 100%;

    -unity-background-scale-mode: scale-to-fit;
}

.character-name {
    position: absolute;

    left: 21%;
    bottom: 100%;

    margin-bottom: 3px;

    color: rgb(218, 166, 67);

    font-size: 35px;
    -unity-font-style: bold;

    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(20, 12, 8);
}

.dialogue-content {
    position: absolute;

    left: 25%;
    right: 10%;
    top: 12%;
    bottom: 12%;

    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;

    min-width: 0;
    min-height: 0;
}

.dialogue-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;

    color: rgb(73, 53, 34);

    font-size: 16px;
    white-space: normal;

    -unity-text-align: upper-left;
}

.next-button {
    position: absolute;

    right: 0;
    bottom: 0;

    min-width: 100px;
    height: 28px;

    margin: 0;
    padding-left: 8px;
    padding-right: 8px;

    background-color: rgb(51, 36, 63);
    color: rgb(248, 231, 199);

    font-size: 13px;
    -unity-font-style: bold;

    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;

    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;

    border-top-color: rgb(198, 154, 85);
    border-bottom-color: rgb(198, 154, 85);
    border-left-color: rgb(198, 154, 85);
    border-right-color: rgb(198, 154, 85);
}

.next-button:hover {
    background-color: rgb(77, 54, 91);
}

.next-button:active {
    background-color: rgb(39, 27, 49);
}
