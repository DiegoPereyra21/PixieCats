<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/HUD/Endings.uss?fileID=7433441132597879392&amp;guid=3b1a840481368ae44b84f6bf0e18d715&amp;type=3#Endings"/>
    <ui:VisualElement name="FaeEnding" class="ending-panel">
        <ui:VisualElement class="ending-image" style="background-image: url(&quot;project://database/Assets/_Project/Art/Background/Final_Meh.png?fileID=2800000&amp;guid=78532756af14ddf49a5cf938ccc4395f&amp;type=3#Final_Meh&quot;);"/>
        <ui:Label class="ending-text" text="No volviste a casa a tiempo demasiadas veces... &#10;el reino de las hadas ha cerrado tus puertas para ti " style="top: 34%; color: rgb(255, 0, 0);"/>
    </ui:VisualElement>
    <ui:VisualElement name="HappyEnding" class="ending-panel">
        <ui:VisualElement class="ending-image" style="background-image: url(&quot;project://database/Assets/_Project/Art/Background/Final_Bueno.png?fileID=2800000&amp;guid=e30e2068c3a288e47b8b1f2da67e089f&amp;type=3#Final_Bueno&quot;);"/>
        <ui:Label class="ending-text" text="Aprendiste a decir que no y a mantener un balance &#10;entre ayudar a otrs y protegerte a vos misma" style="top: 56%; color: rgb(0, 0, 0);"/>
    </ui:VisualElement>
    <ui:VisualElement name="DepressionEnding" class="ending-panel">
        <ui:VisualElement class="ending-image" style="background-image: url(&quot;project://database/Assets/_Project/Art/Background/Final_Malo_SinCalavera.png?fileID=2800000&amp;guid=553a3db0a2950e64cb59d9ac71e8073d&amp;type=3#Final_Malo_SinCalavera&quot;);"/>
        <ui:Label class="ending-text" text="Ayudaste a la gente, pero no tanto como querias,&#10;ahora las personas no confian en tu palabra,&#10;te deprimiste y alejaste en lo oscuro del bosque" style="top: 28%; color: rgb(255, 0, 0);"/>
    </ui:VisualElement>
    <ui:VisualElement name="SacrificeEnding" class="ending-panel">
        <ui:VisualElement class="ending-image" style="background-image: url(&quot;project://database/Assets/_Project/Art/Background/Final_Malo.png?fileID=2800000&amp;guid=42179edec5854b64ea60aa857cf99bc0&amp;type=3#Final_Malo&quot;);"/>
        <ui:Label class="ending-text" text="Hiciste todo lo que se esperaba de vos, pero pagaste un gran precio,&#10;no cuidaste de tu salud y terminaste muriendo de agotamiento" style="top: 17%; color: rgb(255, 0, 0);"/>
    </ui:VisualElement>
    <ui:VisualElement name="CommunityEnding" class="ending-panel">
        <ui:VisualElement class="ending-image" style="background-image: url(&quot;project://database/Assets/_Project/Art/Background/Final_Bueno.png?fileID=2800000&amp;guid=e30e2068c3a288e47b8b1f2da67e089f&amp;type=3#Final_Bueno&quot;);"/>
        <ui:Label class="ending-text" text="No cuidaste de vos misma y te desmayaste el medio del bosque...&#10;los aldeanos te encontraron al borde de la muerte&#10;te llevaron al portal para que puedan curarte en tu casa" style="top: 53%; color: rgb(255, 249, 249);"/>
    </ui:VisualElement>
    <ui:VisualElement name="OneWithTheDustEnding" class="ending-panel">
        <ui:VisualElement class="ending-image" style="background-image: url(&quot;project://database/Assets/_Project/Art/Background/Final_Malo.png?fileID=2800000&amp;guid=42179edec5854b64ea60aa857cf99bc0&amp;type=3#Final_Malo&quot;);"/>
        <ui:Label class="ending-text" text="Te abandonaste completamente, tu vida termino y volviste al polvo" style="top: 16%; color: rgb(255, 0, 0);"/>
    </ui:VisualElement>
    <ui:VisualElement name="OneWithTheForestEnding" class="ending-panel">
        <ui:VisualElement class="ending-image" style="background-image: url(&quot;project://database/Assets/_Project/Art/Background/Final_Bueno.png?fileID=2800000&amp;guid=e30e2068c3a288e47b8b1f2da67e089f&amp;type=3#Final_Bueno&quot;);"/>
        <ui:Label class="ending-text" text=" fallaste en ayudar a otros , &#10;pero estas bien con vos misma, hiciste lo mejor que pudiste" style="top: 63%; color: rgb(255, 255, 255);"/>
    </ui:VisualElement>
    <ui:Button name="BackToMenuButton" text="VOLVER AL MENÚ" class="ending-button" style="position: absolute; right: 4%; bottom: 6%; display: none;"/>
</ui:UXML>