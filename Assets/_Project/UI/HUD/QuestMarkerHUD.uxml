<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="QuestMarkerHUD.uss" />
    <ui:VisualElement name="QuestArrowRoot" picking-mode="Ignore" class="arrow-root">
        <ui:VisualElement name="ArrowAnchor" picking-mode="Ignore" class="arrow-anchor arrow-anchor--hidden">
            <ui:VisualElement name="ArrowPivot" picking-mode="Ignore" class="arrow-pivot">
                <ui:VisualElement name="Arrow" picking-mode="Ignore" class="arrow" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>