.arrow-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.arrow-anchor {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.arrow-anchor--hidden {
    opacity: 0;
}

.arrow-pivot {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

.arrow {
    position: absolute;
    left: 0;
    top: -48px;
    width: 96px;
    height: 96px;
    -unity-background-scale-mode: scale-to-fit;
}